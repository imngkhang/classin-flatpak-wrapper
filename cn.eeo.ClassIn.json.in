{
    "app-id": "cn.eeo.ClassIn",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "/app/bin/classin-wrapper",
    "finish-args": [
       "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=pulseaudio",
        "--device=all",
        "--filesystem=host",
        "--allow=devel"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/aclocal",
        "/share/gtk-doc",
        "/share/locale",
        "/share/man",
        "/share/runtime"
    ],
    "modules": [
        {
            "name": "classin-wrapper",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "file",
                    "path": "classin-wrapper"
                },
                {
                    "type": "file",
                    "path": "cn.eeo.ClassIn.metainfo.xml"
                },
                {
                    "type": "file",
                    "path": "cn.eeo.ClassIn.amd64.desktop",
                    "only-arches": [
                        "x86_64"
                    ]
                },
                {
                    "type": "file",
                    "path": "cn.eeo.ClassIn.arm64.desktop",
                    "only-arches": [
                        "aarch64"
                    ]
                },
                {
                    "type": "file",
                    "path": "classin.svg"
                }
            ],
            "build-commands": [
                "install -d /app/bin",
                "install classin-wrapper /app/bin/classin-wrapper",
                "install -d /app/share/metainfo",
                "install -m644 cn.eeo.ClassIn.metainfo.xml /app/share/metainfo/cn.eeo.ClassIn.metainfo.xml",
                "install -d /app/share/applications",
                "if [ -f cn.eeo.ClassIn.amd64.desktop ]; then install -m644 cn.eeo.ClassIn.amd64.desktop /app/share/applications/cn.eeo.ClassIn.desktop; fi",
                "if [ -f cn.eeo.ClassIn.arm64.desktop ]; then install -m644 cn.eeo.ClassIn.arm64.desktop /app/share/applications/cn.eeo.ClassIn.desktop; fi",
                "install -d /app/share/icons/hicolor/scalable/apps",
                "install -m644 classin.svg /app/share/icons/hicolor/scalable/apps/cn.eeo.ClassIn.svg",
                "install -d /app/share/mime/packages",
                "ln -s /app/extra/usr/share/mime/packages/eeo-edb-mime.xml /app/share/mime/packages/cn.eeo.ClassIn.xml"
            ]
        },
        {
            "name": "classin",
            "buildsystem": "simple",
            "sources": [
                {
                    "type": "extra-data",
                    "filename": "classin-amd64.deb",
                    "only-arches": [
                        "x86_64"
                    ],
                    "url": "@CLASSIN_URL_AMD64@",
                    "sha256": "@CLASSIN_SHA256_AMD64@",
                    "size": "@CLASSIN_SIZE_AMD64@"
                },
                {
                    "type": "extra-data",
                    "filename": "classin-arm64.deb",
                    "only-arches": [
                        "aarch64"
                    ],
                    "url": "@CLASSIN_URL_ARM64@",
                    "sha256": "@CLASSIN_SHA256_ARM64@",
                    "size": "@CLASSIN_SIZE_ARM64@"
                },
                {
                    "type": "file",
                    "path": "install.sh"
                }
            ],
            "build-commands": [
                "install -Dm 755 install.sh /app/bin/apply_extra",
                "install /usr/bin/ar /app/bin/ar",
                "install -d /app/lib",
                "install -t /app/lib /usr/lib/x86_64-linux-gnu/libsframe.so.3",
                "install -t /app/lib /usr/lib/x86_64-linux-gnu/libbfd-*.so"
            ]
        }
    ]
}